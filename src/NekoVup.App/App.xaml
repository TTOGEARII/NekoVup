<Application
    x:Class="NekoVup.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ── 만화 원고풍 팔레트: 종이 흰색 + 먹선 검정. 다크는 그대로 반전. 포인트도 색 대신 굵기와 반전으로 준다. ── -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="NekoBg" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="NekoCard" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="NekoCardHover" Color="#EFEFEF" />
                    <SolidColorBrush x:Key="NekoText" Color="#111111" />
                    <SolidColorBrush x:Key="NekoHint" Color="#595959" />
                    <SolidColorBrush x:Key="NekoStroke" Color="#111111" />
                    <SolidColorBrush x:Key="NekoCanvas" Color="#E8E8E8" />
                    <SolidColorBrush x:Key="NekoWarnBg" Color="#33FFB020" />
                    <SolidColorBrush x:Key="NekoWarnText" Color="#8A5A00" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="NekoBg" Color="#111111" />
                    <SolidColorBrush x:Key="NekoCard" Color="#111111" />
                    <SolidColorBrush x:Key="NekoCardHover" Color="#242424" />
                    <SolidColorBrush x:Key="NekoText" Color="#F5F5F5" />
                    <SolidColorBrush x:Key="NekoHint" Color="#A3A3A3" />
                    <SolidColorBrush x:Key="NekoStroke" Color="#F5F5F5" />
                    <SolidColorBrush x:Key="NekoCanvas" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="NekoWarnBg" Color="#33FFB020" />
                    <SolidColorBrush x:Key="NekoWarnText" Color="#FFCF6E" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- 강조색 = 먹색. 화이트 테마의 컨트롤은 Dark 쪽 단계를, 다크 테마의 컨트롤은 Light 쪽 단계를 쓴다. -->
            <Color x:Key="SystemAccentColor">#111111</Color>
            <Color x:Key="SystemAccentColorDark1">#111111</Color>
            <Color x:Key="SystemAccentColorDark2">#111111</Color>
            <Color x:Key="SystemAccentColorDark3">#111111</Color>
            <Color x:Key="SystemAccentColorLight1">#F5F5F5</Color>
            <Color x:Key="SystemAccentColorLight2">#F5F5F5</Color>
            <Color x:Key="SystemAccentColorLight3">#F5F5F5</Color>

            <!-- 각진 모서리로 통일 -->
            <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>

            <!-- 먹선 두른 원고 패널 -->
            <Style x:Key="InkPanel" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource NekoCard}" />
                <Setter Property="BorderBrush" Value="{ThemeResource NekoStroke}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="CornerRadius" Value="0" />
            </Style>

            <!-- 기능 켜고 끄는 카드 -->
            <Style x:Key="NekoFeatureCard" TargetType="Border" BasedOn="{StaticResource InkPanel}">
                <Setter Property="Padding" Value="16,12" />
            </Style>
            <Style x:Key="CardTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource NekoText}" />
            </Style>
            <Style x:Key="HintText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource NekoHint}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- 섹션 제목: 먹색 라벨 바 (원고 지시선·필름 자막 느낌) -->
            <Style x:Key="MangaTag" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource NekoStroke}" />
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Margin" Value="0,14,0,6" />
            </Style>
            <Style x:Key="MangaTagText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource NekoBg}" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontSize" Value="12.5" />
            </Style>

            <!-- 서류철 탭: 선택한 탭은 내용 패널과 같은 종이색이고 패널 윗선을 덮어 이어져 보인다. 나머지는 조금 낮고 바랜다. -->
            <Style x:Key="FolderTab" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{ThemeResource NekoText}" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Tab" Background="{ThemeResource NekoBg}" BorderBrush="{ThemeResource NekoStroke}"
                                    BorderThickness="2,2,2,0" Padding="14,6" Margin="0,5,4,0">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Header.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Header.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="Tab.Background" Value="{ThemeResource NekoCard}" />
                                                <Setter Target="Tab.Margin" Value="0,0,4,-2" />
                                                <Setter Target="Tab.Padding" Value="14,8,14,9" />
                                                <Setter Target="Header.Opacity" Value="1" />
                                                <Setter Target="Header.FontWeight" Value="Bold" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Unchecked" />
                                        <VisualState x:Name="Indeterminate" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="Header" Content="{TemplateBinding Content}" Opacity="0.55"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
