<UserControl
    x:Class="NekoVup.App.Controls.MangaTexture"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False"
    IsHitTestVisible="False"
    SizeChanged="OnSizeChanged">
    <!-- Canvas 안에 두어 도형 크기가 배치에 영향을 주지 않게 한다 -->
    <Canvas>
        <Path x:Name="Shape" Stroke="{ThemeResource NekoStroke}" />
    </Canvas>
</UserControl>
