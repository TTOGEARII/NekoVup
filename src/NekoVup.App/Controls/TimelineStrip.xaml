<UserControl
    x:Class="NekoVup.App.Controls.TimelineStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="66"
    IsTabStop="True"
    UseSystemFocusVisuals="True"
    KeyDown="OnKeyDown">
    <!-- 배경이 칠해져 있어야 빈 곳에서도 포인터 이벤트를 받는다 -->
    <Grid x:Name="Area" Background="{ThemeResource NekoPanel}" SizeChanged="OnSizeChanged"
          PointerPressed="OnPointerPressed"
          PointerMoved="OnPointerMoved"
          PointerReleased="OnPointerReleased"
          PointerCanceled="OnPointerReleased"
          PointerCaptureLost="OnPointerReleased">
        <!-- 코드에서 그리는 도형이 쓸 테마 색. 보이지 않는 도형에 걸어 두고 그 붓을 가져다 쓴다. -->
        <Rectangle x:Name="HintInk" Fill="{ThemeResource NekoHint}" Visibility="Collapsed" />
        <Rectangle x:Name="LineInk" Fill="{ThemeResource NekoStroke}" Visibility="Collapsed" />
        <Rectangle x:Name="TextInk" Fill="{ThemeResource NekoText}" Visibility="Collapsed" />
        <Rectangle x:Name="TrackInk" Fill="{ThemeResource NekoTrack}" Visibility="Collapsed" />
        <Rectangle x:Name="ClipInk" Fill="{ThemeResource NekoClip}" Visibility="Collapsed" />
        <Rectangle x:Name="ActiveInk" Fill="{ThemeResource NekoClipActive}" Visibility="Collapsed" />
        <Rectangle x:Name="PlayheadInk" Fill="{ThemeResource NekoPlayhead}" Visibility="Collapsed" />
        <Canvas x:Name="Surface" IsHitTestVisible="False" />
    </Grid>
</UserControl>
