<Window
    x:Class="NekoVup.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NekoVup.App.Controls"
    xmlns:vm="using:NekoVup.App.ViewModels"
    Title="NekoVup">

    <Grid x:Name="Root" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" Background="{ThemeResource NekoBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ 제목 줄 ═══ -->
        <Grid x:Name="TitleBarArea" Height="38" Padding="12,0,150,0" ColumnSpacing="8" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:NekoLogo Width="20" Height="20" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="NekoVup" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource NekoText}" />
            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.VersionText}" FontSize="12" VerticalAlignment="Center"
                       Foreground="{ThemeResource NekoHint}" />
        </Grid>

        <!-- ═══ 알림 줄 ═══ -->
        <StackPanel Grid.Row="1">
            <InfoBar x:Name="MessageBar" Margin="12,0,12,6" IsClosable="True"
                     IsOpen="{x:Bind ViewModel.HasMessage, Mode=TwoWay}"
                     Message="{x:Bind ViewModel.Message, Mode=OneWay}" />

            <!-- ProPainter 자동 준비 진행 (처음 실행 때 약 3 GB 내려받기) -->
            <Border Style="{StaticResource Panel}" Margin="12,0,12,8" Padding="12,8" Visibility="{x:Bind ViewModel.SetupRunning, Mode=OneWay}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE896;" FontSize="16" Foreground="{ThemeResource NekoAccent}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.SetupText, Mode=OneWay}" FontSize="12.5" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource NekoText}" />
                        <ProgressBar Maximum="100" Value="{x:Bind ViewModel.SetupFraction, Mode=OneWay}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="중지" AutomationProperties.Name="준비 중지" Click="OnCancelSetupClick" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- ═══ 작업 단계: 워터마크 제거 → 업스케일 → 내보내기 ═══ -->
        <Grid Grid.Row="2" Margin="12,0,12,8" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource StepCard}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE75C;" FontSize="20" Foreground="{ThemeResource NekoAccent}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CardTitle}" Text="워터마크 제거" />
                        <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0" Text="{x:Bind ViewModel.RemoveHint, Mode=OneWay}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" VerticalAlignment="Center" MinWidth="0" OnContent="" OffContent=""
                                  AutomationProperties.Name="워터마크 제거"
                                  IsOn="{x:Bind ViewModel.RemoveOn, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.NotRunning, Mode=OneWay}" />
                </Grid>
            </Border>

            <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource NekoHint}" VerticalAlignment="Center" />

            <Border Grid.Column="2" Style="{StaticResource StepCard}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE740;" FontSize="20" Foreground="{ThemeResource NekoAccent}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CardTitle}" Text="업스케일" />
                        <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0" Text="{x:Bind ViewModel.UpscaleHint, Mode=OneWay}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" VerticalAlignment="Center" MinWidth="0" OnContent="" OffContent=""
                                  AutomationProperties.Name="업스케일"
                                  IsOn="{x:Bind ViewModel.UpscaleOn, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.NotRunning, Mode=OneWay}" />
                </Grid>
            </Border>

            <FontIcon Grid.Column="3" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource NekoHint}" VerticalAlignment="Center" />

            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
                <Button AutomationProperties.Name="시작" Click="OnStartClick" Style="{ThemeResource AccentButtonStyle}"
                        VerticalAlignment="Stretch" MinWidth="124" Padding="18,0"
                        IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                        <TextBlock Text="시작" FontWeight="SemiBold" FontSize="14" />
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="중지" Click="OnCancelClick" VerticalAlignment="Stretch" Padding="16,0"
                        IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE71A;" FontSize="14" />
                        <TextBlock Text="중지" FontSize="14" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══ 가운데: 끌어다 놓는 자리 / 작업 공간 ═══ -->
        <Grid Grid.Row="3" Margin="12,0,12,8">

            <!-- 영상이 없을 때 -->
            <Border Style="{StaticResource Panel}" Visibility="{x:Bind ViewModel.NoVideo, Mode=OneWay}">
                <Grid>
                    <Rectangle Margin="18" RadiusX="6" RadiusY="6" Stroke="{ThemeResource NekoStroke}" StrokeThickness="1.5" StrokeDashArray="5,4" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <controls:NekoLogo Width="84" Height="84" HorizontalAlignment="Center" />
                        <TextBlock Text="영상 파일을 여기에 끌어다 놓으세요" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,0"
                                   HorizontalAlignment="Center" Foreground="{ThemeResource NekoText}" />
                        <TextBlock Text="mp4 · mkv · mov · avi · webm" Style="{StaticResource HintText}" Margin="0,6,0,0" HorizontalAlignment="Center" />
                        <Button Click="OnOpenClick" Margin="0,18,0,0" Padding="16,7" HorizontalAlignment="Center" AutomationProperties.Name="파일 고르기">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                <TextBlock Text="파일 고르기" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 영상을 열었을 때: 왼쪽 뷰어 + 타임라인, 오른쪽 옵션 -->
            <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.HasVideo, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="388" />
                </Grid.ColumnDefinitions>

                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 뷰어 -->
                    <Border Style="{StaticResource Panel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource PanelHeader}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource PanelTitle}" Text="미리보기" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.FileName, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{ThemeResource NekoText}" TextTrimming="CharacterEllipsis" MaxWidth="380" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.InfoText, Mode=OneWay}" FontSize="11.5" VerticalAlignment="Center"
                                               Foreground="{ThemeResource NekoHint}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>
                            <Grid Grid.Row="1">
                                <controls:BoxEditor x:Name="Editor" />
                                <ProgressRing x:Name="PreviewBusy" IsActive="False" Width="24" Height="24"
                                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 타임라인 -->
                    <Border Grid.Row="1" Style="{StaticResource Panel}">
                        <StackPanel>
                            <Border Style="{StaticResource PanelHeader}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource PanelTitle}" Text="타임라인" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Timecode}" Text="{x:Bind ViewModel.PreviewTimeText, Mode=OneWay}" />
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                                Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay}">
                                        <TextBlock Text="원본" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource NekoHint}" />
                                        <ToggleSwitch OnContent="" OffContent="" MinWidth="0" MinHeight="0" Margin="0,-6,-8,-6"
                                                      AutomationProperties.Name="결과 보기"
                                                      IsOn="{x:Bind ViewModel.PreviewResult, Mode=TwoWay}" Toggled="OnPreviewSourceToggled" />
                                        <TextBlock Text="결과" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource NekoHint}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <controls:TimelineStrip x:Name="Timeline" PositionChanged="OnTimelineSeek"
                                                    Duration="{x:Bind ViewModel.DurationSeconds, Mode=OneWay}"
                                                    Position="{x:Bind ViewModel.PreviewSeconds, Mode=OneWay}"
                                                    RangeSeconds="{x:Bind ViewModel.RangeSeconds, Mode=OneWay}"
                                                    ClipName="{x:Bind ViewModel.FileName, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 옵션 -->
                <Border Grid.Column="1" Style="{StaticResource Panel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource PanelHeader}">
                            <TextBlock Style="{StaticResource PanelTitle}" Text="작업 옵션" />
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Padding="12,0,12,14" IsHitTestVisible="{x:Bind ViewModel.NotRunning, Mode=OneWay}">

                                <!-- 제거 방식 -->
                                <StackPanel Visibility="{x:Bind ViewModel.NeedsBoxes, Mode=OneWay}">
                                    <Border Style="{StaticResource SectionHeader}" BorderThickness="0" Margin="0,2,0,0">
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="제거 방식" />
                                    </Border>
                                    <RadioButtons SelectedIndex="{x:Bind ViewModel.RemoveMethodIndex, Mode=TwoWay}">
                                        <RadioButton Content="ProPainter — 자연스럽게 복원 (느림, GPU)" />
                                        <RadioButton Content="delogo — 빠르지만 뭉갠 자국이 남음" />
                                    </RadioButtons>
                                </StackPanel>

                                <!-- 박스 -->
                                <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.NeedsBoxes, Mode=OneWay}">
                                    <Border Style="{StaticResource SectionHeader}" Padding="0,8,0,2">
                                        <Grid>
                                            <TextBlock Style="{StaticResource SectionTitle}" Text="워터마크 위치" VerticalAlignment="Center" />
                                            <Button HorizontalAlignment="Right" Padding="8,3" Click="OnAddBoxClick" AutomationProperties.Name="박스 추가"
                                                    IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE710;" FontSize="11" />
                                                    <TextBlock Text="박스 추가" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <TextBlock Style="{StaticResource HintText}"
                                               Text="미리보기 위에서 끌어서 그립니다. 박스 안을 끌면 이동, 손잡이로 크기 조절, Delete로 삭제. 워터마크가 영상 내내 같은 자리에 있어야 합니다." />
                                    <Grid ColumnSpacing="6" Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="36" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="X" Style="{StaticResource HintText}" />
                                        <TextBlock Grid.Column="1" Text="Y" Style="{StaticResource HintText}" />
                                        <TextBlock Grid.Column="2" Text="너비" Style="{StaticResource HintText}" />
                                        <TextBlock Grid.Column="3" Text="높이" Style="{StaticResource HintText}" />
                                    </Grid>
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Boxes}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="6" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:BoxViewModel">
                                                <Grid ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="36" />
                                                    </Grid.ColumnDefinitions>
                                                    <NumberBox Value="{x:Bind X, Mode=TwoWay}" Minimum="0" SmallChange="1" />
                                                    <NumberBox Grid.Column="1" Value="{x:Bind Y, Mode=TwoWay}" Minimum="0" SmallChange="1" />
                                                    <NumberBox Grid.Column="2" Value="{x:Bind Width, Mode=TwoWay}" Minimum="1" SmallChange="1" />
                                                    <NumberBox Grid.Column="3" Value="{x:Bind Height, Mode=TwoWay}" Minimum="1" SmallChange="1" />
                                                    <Button Grid.Column="4" Padding="6" Click="OnRemoveBoxClick" ToolTipService.ToolTip="이 박스 삭제">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                    <TextBlock Text="{x:Bind ViewModel.RegionText, Mode=OneWay}" Style="{StaticResource HintText}" />
                                    <Border Background="{ThemeResource NekoWarnBg}" Padding="8,5" CornerRadius="3"
                                            Visibility="{x:Bind ViewModel.HasRegionWarning, Mode=OneWay}">
                                        <TextBlock Text="{x:Bind ViewModel.RegionWarning, Mode=OneWay}" FontSize="11.5" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource NekoWarnText}" />
                                    </Border>
                                </StackPanel>

                                <!-- 업스케일 -->
                                <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.UpscaleEnabled, Mode=OneWay}">
                                    <Border Style="{StaticResource SectionHeader}" Padding="0,10,0,2">
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="업스케일" />
                                    </Border>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="96" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox HorizontalAlignment="Stretch" SelectedIndex="{x:Bind ViewModel.UpscalePresetIndex, Mode=TwoWay}">
                                            <ComboBoxItem Content="애니메이션 — 빠름" />
                                            <ComboBoxItem Content="애니메이션 — 고품질" />
                                            <ComboBoxItem Content="실사" />
                                            <ComboBoxItem Content="옛 비디오 (캠코더·VHS)" />
                                        </ComboBox>
                                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind ViewModel.ScaleIndex, Mode=TwoWay}">
                                            <ComboBoxItem Content="2배" />
                                            <ComboBoxItem Content="3배" />
                                            <ComboBoxItem Content="4배" />
                                        </ComboBox>
                                    </Grid>
                                    <TextBlock Text="{x:Bind ViewModel.OutputSizeText, Mode=OneWay}" Style="{StaticResource HintText}" />
                                    <Grid ColumnSpacing="10" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="28" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="선명도" VerticalAlignment="Center" Foreground="{ThemeResource NekoText}" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" StepFrequency="5" TickFrequency="25" TickPlacement="Outside"
                                                Value="{x:Bind ViewModel.Sharpen, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="선명도" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.SharpenText, Mode=OneWay}" Style="{StaticResource Timecode}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="업스케일 뒤 경계를 또렷하게 세웁니다. 결과가 흐릿하게 느껴지면 30~50부터 올려 보세요. 너무 높이면 테두리가 뜹니다. 끔↔켬을 바꾸면 업스케일을 다시 합니다."
                                               Style="{StaticResource HintText}" />
                                </StackPanel>

                                <!-- 구간 -->
                                <Border Style="{StaticResource SectionHeader}">
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="구간" />
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <CheckBox Content="앞부분만 시험 삼아 처리" IsChecked="{x:Bind ViewModel.TestSection, Mode=TwoWay}" MinWidth="0" />
                                    <NumberBox Width="84" Minimum="1" SmallChange="5" Value="{x:Bind ViewModel.TestSeconds, Mode=TwoWay}"
                                               IsEnabled="{x:Bind ViewModel.TestSection, Mode=OneWay}" />
                                    <TextBlock Text="초" VerticalAlignment="Center" Foreground="{ThemeResource NekoText}" />
                                </StackPanel>

                                <!-- 출력 -->
                                <Border Style="{StaticResource SectionHeader}">
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="출력 파일" />
                                </Border>
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{x:Bind ViewModel.OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Content="찾아보기" Click="OnBrowseOutputClick" />
                                </Grid>
                                <TextBlock Text="자막을 유지하려면 .mkv로 저장하세요." Style="{StaticResource HintText}" Margin="0,6,0,0" />

                                <!-- 고급 -->
                                <Expander Header="고급 옵션" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,14,0,0">
                                    <Grid ColumnSpacing="10" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <NumberBox Header="박스 둘레 여백 (px)" Minimum="0" Maximum="2000" Value="{x:Bind ViewModel.Pad, Mode=TwoWay}" />
                                        <NumberBox Grid.Column="1" Header="영역 면적 상한 (px)" Minimum="10000" Value="{x:Bind ViewModel.MaxArea, Mode=TwoWay}" />
                                        <NumberBox Grid.Row="1" Header="조각 길이 (프레임)" Minimum="20" Maximum="1000" Value="{x:Bind ViewModel.ChunkLength, Mode=TwoWay}" />
                                        <NumberBox Grid.Row="1" Grid.Column="1" Header="조각 겹침 (프레임)" Minimum="0" Maximum="200" Value="{x:Bind ViewModel.Overlap, Mode=TwoWay}" />
                                        <NumberBox Grid.Row="2" Header="ProPainter subvideo" Minimum="10" Maximum="500" Value="{x:Bind ViewModel.SubvideoLength, Mode=TwoWay}" />
                                        <NumberBox Grid.Row="2" Grid.Column="1" Header="화질 CRF (낮을수록 고화질)" Minimum="0" Maximum="40" Value="{x:Bind ViewModel.Crf, Mode=TwoWay}" />
                                        <ComboBox Grid.Row="3" Grid.ColumnSpan="2" Header="인터레이스(빗살 무늬) 해제" HorizontalAlignment="Stretch"
                                                  SelectedIndex="{x:Bind ViewModel.DeinterlaceIndex, Mode=TwoWay}">
                                            <ComboBoxItem Content="자동 — 파일에 인터레이스 표기가 있을 때만" />
                                            <ComboBoxItem Content="항상 — 옛 캠코더·DVD 녹화인데 표기가 없을 때" />
                                            <ComboBoxItem Content="안 함" />
                                        </ComboBox>
                                    </Grid>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══ 작업 진행 ═══ -->
        <Border Grid.Row="4" Style="{StaticResource Panel}" Margin="12,0,12,8" Visibility="{x:Bind ViewModel.HasRun, Mode=OneWay}">
            <StackPanel>
                <Border Style="{StaticResource PanelHeader}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource PanelTitle}" Text="작업 진행" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StageText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{ThemeResource NekoAccent}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.DetailText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource NekoHint}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.EtaText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource NekoHint}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <StackPanel Padding="12,10,12,10" Spacing="8">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="단계" FontSize="12" Foreground="{ThemeResource NekoHint}" VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="1" Maximum="100" Value="{x:Bind ViewModel.StageProgress, Mode=OneWay}" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="전체" FontSize="12" Foreground="{ThemeResource NekoHint}" VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="1" Maximum="100" Value="{x:Bind ViewModel.TotalProgress, Mode=OneWay}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.TotalText, Mode=OneWay}" Style="{StaticResource Timecode}" FontSize="12" HorizontalAlignment="Right" />
                    </Grid>
                    <Expander Header="로그" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <ListView x:Name="LogList" Height="140" SelectionMode="None" ItemsSource="{x:Bind ViewModel.Log}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="4,1" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Expander>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══ 상태 줄 ═══ -->
        <Border Grid.Row="5" Padding="6,3,12,3" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource NekoStroke}" Background="{ThemeResource NekoHeader}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button x:Name="SettingsButton" Style="{StaticResource ToolButton}" AutomationProperties.Name="설정" Click="OnSettingsClick">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE713;" FontSize="13" />
                            <TextBlock Text="설정" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" AutomationProperties.Name="영상 열기" Click="OnOpenClick"
                            IsEnabled="{x:Bind ViewModel.NotRunning, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE8E5;" FontSize="13" />
                            <TextBlock Text="영상 열기" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" AutomationProperties.Name="결과 폴더" Click="OnOpenFolderClick">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                            <TextBlock Text="결과 폴더" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" AutomationProperties.Name="테마 바꾸기" Click="OnThemeClick">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE793;" FontSize="13" />
                            <TextBlock Text="{x:Bind ViewModel.ThemeButtonText, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="업데이트" Click="OnUpdateClick" Padding="10,4" Margin="6,0,0,0" FontSize="12.5"
                            Style="{ThemeResource AccentButtonStyle}"
                            Visibility="{x:Bind ViewModel.UpdateAvailable, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.NotUpdating, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE896;" FontSize="13" />
                            <TextBlock Text="{x:Bind ViewModel.UpdateButtonText, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource NekoHint}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <!-- ═══ 설정 대화 상자 ═══ -->
        <ContentDialog x:Name="SettingsDialog" PrimaryButtonText="저장" CloseButtonText="닫기" DefaultButton="Primary">
            <ContentDialog.Resources>
                <!-- 기본 최대 폭(548)으로는 경로 입력 칸이 잘린다 -->
                <x:Double x:Key="ContentDialogMaxWidth">720</x:Double>
            </ContentDialog.Resources>
            <ContentDialog.Title>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <controls:NekoLogo Width="26" Height="26" VerticalAlignment="Center" />
                    <TextBlock Text="설정" VerticalAlignment="Center" />
                </StackPanel>
            </ContentDialog.Title>

            <Grid Width="600" Height="460">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 탭 줄 -->
                <Border BorderBrush="{ThemeResource NekoStroke}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabTools" Style="{StaticResource FlatTab}" GroupName="SettingsTabs" Content="도구" IsChecked="True" Checked="OnSettingsTabChecked" />
                        <RadioButton x:Name="TabLook" Style="{StaticResource FlatTab}" GroupName="SettingsTabs" Content="화면" Checked="OnSettingsTabChecked" />
                        <RadioButton x:Name="TabAbout" Style="{StaticResource FlatTab}" GroupName="SettingsTabs" Content="정보" Checked="OnSettingsTabChecked" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="0,4,0,0">

                    <!-- 도구 -->
                    <ScrollViewer x:Name="PanelTools" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8" Margin="2,0,16,8">
                            <Border Style="{StaticResource SectionHeader}" BorderThickness="0" Margin="0,2,0,0" Padding="0,10,0,2">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="도구 위치" />
                            </Border>
                            <TextBlock Style="{StaticResource HintText}" Text="{x:Bind ViewModel.ToolsHint}" />
                            <TextBox Header="ffmpeg" PlaceholderText="{x:Bind ViewModel.FfmpegPlaceholder}"
                                     Text="{x:Bind ViewModel.EditFfmpeg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Header="ffprobe" PlaceholderText="{x:Bind ViewModel.FfprobePlaceholder}"
                                     Text="{x:Bind ViewModel.EditFfprobe, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Border Style="{StaticResource SectionHeader}" Padding="0,10,0,2">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="ProPainter (워터마크 복원)" />
                            </Border>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="처음 실행할 때 자동으로 준비합니다(파이썬 + PyTorch, 약 3 GB 내려받기). 중지했거나 실패했으면 여기서 다시 시작하세요. 직접 설치한 ProPainter를 쓰려면 아래에 경로를 적으면 됩니다." />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="ProPainter 자동 준비" Click="OnSetupProPainterClick" IsEnabled="{x:Bind ViewModel.NotSettingUp, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.SetupStatus, Mode=OneWay}" Style="{StaticResource HintText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="400" />
                            </StackPanel>
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Header="ProPainter용 Python (보통 ProPainter\venv\Scripts\python.exe)"
                                         Text="{x:Bind ViewModel.EditPython, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Content="찾기" VerticalAlignment="Bottom" Click="OnBrowsePythonClick" />
                            </Grid>
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Header="ProPainter 폴더 (inference_propainter.py가 있는 곳)"
                                         Text="{x:Bind ViewModel.EditProPainterDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Content="찾기" VerticalAlignment="Bottom" Click="OnBrowseProPainterClick" />
                            </Grid>
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Header="Video2X (video2x.exe)" PlaceholderText="{x:Bind ViewModel.Video2XPlaceholder}"
                                         Text="{x:Bind ViewModel.EditVideo2X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Content="찾기" VerticalAlignment="Bottom" Click="OnBrowseVideo2XClick" />
                            </Grid>

                            <Border Style="{StaticResource SectionHeader}" Padding="0,10,0,2">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="환경 점검" />
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="환경 점검" Click="OnCheckClick" />
                                <ProgressRing IsActive="{x:Bind ViewModel.IsChecking, Mode=OneWay}" Width="20" Height="20" />
                            </StackPanel>
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.CheckItems}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="6" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CheckItemViewModel">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Glyph}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind Detail}" FontSize="12" Opacity="0.8" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 화면 -->
                    <StackPanel x:Name="PanelLook" Margin="2,0,8,8" Visibility="Collapsed">
                        <Border Style="{StaticResource SectionHeader}" BorderThickness="0" Margin="0,2,0,0">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="테마" />
                        </Border>
                        <RadioButtons SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                            <RadioButton Content="라이트" />
                            <RadioButton Content="다크" />
                        </RadioButtons>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0" Text="고르는 즉시 바뀌고 저장됩니다. 아래 상태 줄의 테마 단추로도 바꿀 수 있습니다." />
                    </StackPanel>

                    <!-- 정보 -->
                    <StackPanel x:Name="PanelAbout" Margin="2,0,8,8" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,14,0,0">
                            <controls:NekoLogo Width="64" Height="64" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="NekoVup" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource NekoText}" />
                                <TextBlock Text="{x:Bind ViewModel.VersionText}" Foreground="{ThemeResource NekoHint}" />
                                <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0" Text="영상의 워터마크를 지우고 업스케일하는 프로그램" />
                            </StackPanel>
                        </StackPanel>

                        <Border Style="{StaticResource SectionHeader}">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="업데이트" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="새 버전 확인" Click="OnCheckUpdateClick" IsEnabled="{x:Bind ViewModel.NotUpdating, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.UpdateStatus, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{ThemeResource NekoHint}" MaxWidth="420" />
                        </StackPanel>

                        <Border Style="{StaticResource SectionHeader}">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="바로 가기" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="GitHub 열기" Click="OnOpenRepoClick" />
                            <Button Content="설정 폴더 열기" Click="OnOpenDataFolderClick" />
                            <Button x:Name="UninstallButton" Content="프로그램 제거" Click="OnUninstallClick" Visibility="Collapsed" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,14,0,0"
                                   Text="FFmpeg · ProPainter · Video2X를 불러 씁니다. 각 도구는 저마다의 라이선스를 따릅니다 (ProPainter는 비상업적 용도만 허용)." />
                    </StackPanel>
                </Grid>
            </Grid>
        </ContentDialog>
    </Grid>
</Window>
