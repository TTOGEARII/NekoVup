<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>NekoVup.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 트리밍·AOT·단일 파일 분석기를 켠다. 리플렉션 기반 코드는 여기서 경고(=오류)가 된다. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.369" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NekoVup.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 파이썬 추론 스크립트: 실행 파일 옆 scripts\ 폴더로 복사된다 (앱 게시 결과에도 따라간다). -->
    <Content Include="Scripts\realbasicvsr.py" Link="scripts\realbasicvsr.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
